@startuml
!theme plain
skinparam backgroundColor #FEFEFE

title FEAT-002: 多设备登录业务流程

start
:用户登录;
:检查当前会话数;

if (会话数 < 5?) then (是)
    :创建新会话;
    :存储会话信息到 Redis;
    :返回 Access Token + Refresh Token;
    stop
else (否)
    :提示"设备数已达上限";
    :显示已登录设备列表;

    if (用户选择?) then (登出旧设备)
        :用户选择要登出的设备;
        :注销选中设备的会话;
        :通知被登出设备(WebSocket);
        :创建新会话;
        :返回 Token;
        stop
    else (拒绝新登录)
        :返回 SESSION_LIMIT_REACHED 错误;
        :提示"请登出其他设备后重试";
        stop
    endif
endif

@enduml
